<Window x:Class="WiredMonitorClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wired Monitor - 扩展屏客户端"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border x:Name="TopToolbar" Grid.Row="0" Background="#FF2D2D2D" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Wired Monitor" Foreground="White"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mac 地址:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="HostTextBox" Text="169.254.79.57" Width="140"
                             Background="#FF3C3C3C" Foreground="White" BorderBrush="#FF555555"
                             Padding="5,3" VerticalContentAlignment="Center"/>
                    <TextBlock Text="端口:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="PortTextBox" Text="9802" Width="60"
                             Background="#FF3C3C3C" Foreground="White" BorderBrush="#FF555555"
                             Padding="5,3" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="Usb4IpStatusText" Text="USB4IP: 检测中"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click"
                            Width="80" Height="28" Margin="5,0"
                            Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectButton_Click"
                            Width="80" Height="28" Margin="5,0"
                            Background="#FFCC3333" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                    <Button x:Name="FullscreenButton" Content="全屏" Click="FullscreenButton_Click"
                            Width="80" Height="28" Margin="5,0"
                            Background="#FF444444" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画面显示区 -->
        <Grid x:Name="DisplayHost" Grid.Row="1" Background="#FF000000"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Image x:Name="DisplayImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Canvas x:Name="CursorOverlay" IsHitTestVisible="False">
                <Path x:Name="RemoteCursor"
                      Visibility="Collapsed"
                      Fill="White"
                      Stroke="Black"
                      StrokeThickness="1.2"
                      Data="M 0,0 L 0,22 L 6,16 L 10,27 L 15,25 L 11,14 L 20,14 Z"/>
            </Canvas>
            <TextBlock x:Name="StatusText" Text="未连接 - 请输入 Mac 的 Thunderbolt IP 地址"
                       Foreground="#FF666666" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- 底部状态栏 -->
        <Border x:Name="BottomStatusBar" Grid.Row="2" Background="#FF2D2D2D" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="#FFCC3333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="未连接"
                           Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock x:Name="FpsText" Grid.Column="2" Text=""
                           Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                <TextBlock x:Name="FrameSizeText" Grid.Column="3" Text=""
                           Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
